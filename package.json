{
  "name": "@YueZeyi/dsh-glm-quota",
  "version": "1.0.0",
  "type": "module",
  "description": "在 DeepSeek Harness 桌面端输入框正下方查看智谱 GLM Coding Plan 的剩余额度：当前模型是 GLM 时显示两个剩余百分比，点开有剩余量、进度条与重置时间",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "harness-plugin",
    "glm",
    "zhipu",
    "bigmodel",
    "quota",
    "coding-plan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yue-Zeyi/dsh-glm-quota.git"
  },
  "engines": {
    "node": ">=20"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
